
COMMON=/uufs/chpc.utah.edu/common/home

UV_CACHE_DIR=$TMPDIR/uv-cache

# User Config
BACKUP=$HOME/.backup

# Editors
VISUAL='nano'

# Lin Group
LINGROUP_DATA_DIR=$COMMON/lin-group11/group_data
LINGROUP_MEASUREMENTS_DIR=$COMMON/lin-group25/measurements
LINGROUP_HRRR_DIR=$COMMON/lin-group21/hrrr/hrrr

# Lair configuration
# (lair has no built-in data paths; readers fall back to these LAIR_* roots)
LAIR_CACHE_DIR=$COMMON/lin-group23/jkm/lair_cache
LAIR_INVENTORY_DIR=$LINGROUP_DATA_DIR/inventories
LAIR_SOUNDING_DIR=$LINGROUP_DATA_DIR/soundings
LAIR_CARBONTRACKER_DIR=$LINGROUP_DATA_DIR/carbontracker
LAIR_GML_DIR=$LINGROUP_DATA_DIR/gml

# SLV package configuration
SLV_USER_DATA_DIR=$HOME/wkspace/methane/SLV/data
SLV_ARLMET_DIR=$LINGROUP_DATA_DIR/NOAA-ARL_formatted_metfields
SLV_DAQ_DIR=$LINGROUP_DATA_DIR/DAQ
SLV_INVENTORIES_DIR=$LINGROUP_DATA_DIR/inventories
SLV_SPATIAL_DIR=$LINGROUP_DATA_DIR/spatial
SLV_SOUNDINGS_DIR=$LINGROUP_DATA_DIR/soundings

# STILT configuration
# Production PYSTILT project (WBB+DAQ+TRAX receptors, 2015-2026, full 24 h back).
# Tree layout: ~/wkspace/stilt/README.md. slv.inversion.InversionConfig reads SLV_STILT_DIR.
STILT_DIR=$COMMON/lin-group27/jkm/stilt/simulations/stilt
SLV_STILT_DIR=$STILT_DIR

# Scratch HRRR directory
SCRATCH_HRRR_DIR=/scratch/general/vast/u6036966/hrrr/hrrr
