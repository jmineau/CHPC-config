
COMMON=/uufs/chpc.utah.edu/common/home

# User Config
BACKUP=$HOME/.backup
USRTMP=$HOME/tmp

# Editors
VISUAL='nano'

# Lin Group
LINGROUP_DATA_DIR=$COMMON/lin-group11/group_data
LINGROUP_MEASUREMENTS_DIR=$COMMON/lin-group25/measurements

# Lair configuration
LAIR_CACHE_DIR=$COMMON/lin-group23/jkm/lair_cache

# SLV package configuration
SLV_ARLMET_DIR=$LINGROUP_DATA_DIR/NOAA-ARL_formatted_metfields
SLV_DAQ_DIR=$HOME/wkspace/methane/SLV/data/DAQ/processed
SLV_INVENTORIES_DIR=$LINGROUP_DATA_DIR/inventories
SLV_PCAP_DIR=$HOME/wkspace/meteorology/PCAP
SLV_SPATIAL_DIR=$LINGROUP_DATA_DIR/spatial
SLV_SOUNDINGS_DIR=$LINGROUP_DATA_DIR/soundings

# STILT configuration
STILT_DIR=$COMMON/lin-group15/jkm/STILT
